{
    "$schema": "https://openapi.vercel.sh/vercel.json",

    "installCommand": "php -v && composer install --no-dev --optimize-autoloader && npm install",

    "buildCommand": "npm run build",

    "functions": {
        "api/lambda.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },

    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/lambda.php"
        }
    ]
}